# =============================================================================
# Runbook Guardian - Variables de entorno
# =============================================================================
# Copiar este archivo a .env y configurar los valores.
# NUNCA commitear el archivo .env con valores reales.
# =============================================================================

# --- Aplicación ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Runbooks ---
RUNBOOKS_PATH=./data/runbooks
RUNBOOK_MAX_AGE_DAYS=90

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=runbooks

# --- AWS (Fase 2 - opcional para MVP local) ---
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# S3_RUNBOOKS_BUCKET=
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_KNOWLEDGE_BASE_ID=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

# --- RAG Provider ---
# Opciones: local | bedrock | auto
RAG_PROVIDER=local

# --- Bedrock Retrieval ---
# BEDROCK_MAX_TOKENS=500
# BEDROCK_TEMPERATURE=0.1
# BEDROCK_TIMEOUT_SECONDS=10

# --- Seguridad ---
# Patrones considerados destructivos (regex, separados por |)
DESTRUCTIVE_PATTERNS=rm\s+-rf|drop\s+database|delete\s+from|truncate|format\s+c:|shutdown\s+-h

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
